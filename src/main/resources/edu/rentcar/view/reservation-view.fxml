<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.rentcar.controller.ReservationController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Rental reservation workflow" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1d3557;"/>

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints minWidth="100"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                <ColumnConstraints minWidth="100"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
            </columnConstraints>

            <!-- Fila 0 -->
            <Label text="Customer:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="customerCombo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Vehicle:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="vehicleCombo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Fila 1 -->
            <Label text="Start date:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="startDatePicker" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="End date:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <DatePicker fx:id="endDatePicker" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Fila 2 -->
            <Label text="Rental mode:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="modeCombo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Payment token:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <ComboBox fx:id="tokenCombo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        </GridPane>

        <Separator/>

        <Label text="Additional services &amp; packages" style="-fx-font-weight: bold; -fx-text-fill: #1d3557;"/>
        <HBox spacing="20">
            <CheckBox fx:id="gpsCheck" text="GPS"/>
            <CheckBox fx:id="childSeatCheck" text="Child Seat"/>
            <CheckBox fx:id="extraDriverCheck" text="Extra Driver"/>
            <CheckBox fx:id="familyPackCheck" text="Family Pack"/>
            <CheckBox fx:id="completePackCheck" text="Complete Pack"/>
        </HBox>

        <Separator/>

        <HBox spacing="10">
            <Button fx:id="quoteButton" text="Quote rental" onAction="#quoteRental" style="-fx-background-color: #1d3557; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button fx:id="payButton" text="Checkout &amp; Pay" onAction="#checkoutRental" disable="true" style="-fx-background-color: #2a9d8f; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button fx:id="clearButton" text="Clear form" onAction="#clearForm"/>
        </HBox>

        <GridPane hgap="20">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <VBox spacing="5" GridPane.columnIndex="0" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
                <Label text="Quote Summary" style="-fx-font-weight: bold;"/>
                <Label fx:id="quoteLabel" text="Calcula una cotización para continuar." wrapText="true"/>
            </VBox>
            <VBox spacing="5" GridPane.columnIndex="1" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
                <Label text="Payment &amp; Reservation Result" style="-fx-font-weight: bold;"/>
                <Label fx:id="resultLabel" text="" wrapText="true" style="-fx-font-weight: bold; -fx-text-fill: #e63946;"/>
            </VBox>
        </GridPane>
    </VBox>

    <Label text="Registered reservations" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1d3557;"/>

    <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="100"/>
            <TableColumn fx:id="customerColumn" text="Customer" prefWidth="120"/>
            <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="120"/>
            <TableColumn fx:id="startColumn" text="Start Date" prefWidth="120"/>
            <TableColumn fx:id="endColumn" text="End Date" prefWidth="120"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>